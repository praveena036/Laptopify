DJANGO_DEBUG=true
DEMO_MODE=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# For production, set DB_ENGINE=django.db.backends.mysql and provide the DB_* values.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Locally the console provider returns a development OTP. Use Twilio Verify in production.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Comma-separated frontend origins, for example https://laptopify.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local SMTP settings (Google requires an App Password, not the account password).
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-sending-address@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
CONTACT_EMAIL_FROM=your-sending-address@gmail.com
CONTACT_EMAIL_TO=your-inbox@example.com

# For production use EMAIL_PROVIDER=resend with a verified sender domain.
RESEND_API_KEY=
